    "test": "node --test scripts/smoke.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "tsx": "4.21.0",
    "vite": "8.1.5"
  }
}
